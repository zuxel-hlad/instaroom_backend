model Contacts {
    id      String   @id @default(cuid())
    phone   Phone?
    openAt  String?  @map("open_at")
    closeAt String?  @map("close_at")
    socials Social[]
}

model Phone {
    id        String   @id @default(cuid())
    number     String
    label     String
    contact   Contacts @relation(fields: [contactId], references: [id])
    contactId String   @unique
}

model Social {
    id         String   @id @default(cuid())
    name       String
    link       String
    contacts   Contacts @relation(fields: [contactsId], references: [id])
    contactsId String
}
