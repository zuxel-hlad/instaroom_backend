model News {
    id          String     @id @default(cuid())
    description String
    news        NewsItem[]
}

model NewsItem {
    id        String   @id @default(cuid())
    image     String
    title     String
    createdAt DateTime @default(now())
    news      News?    @relation(fields: [newsId], references: [id])
    newsId    String?
}
