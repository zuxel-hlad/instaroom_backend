model CatalogMenuItem {
    id       String           @id @default(cuid())
    label    String
    category ProductCategory
    products CatalogProduct[]

    @@map("catalog_menu")
}

model CatalogProduct {
    id            String          @id @default(cuid())
    label         String
    catalogItem   CatalogMenuItem @relation(fields: [catalogItemId], references: [id])
    catalogItemId String

    @@map("catalog_product")
}
