model Product {
    id                       String                  @id @default(cuid())
    brand                    String
    price                    Int
    image                    String?
    images                   String[]                @default([])
    isNew                    Boolean                 @default(false)
    isBestseller             Boolean                 @default(false)
    isPromotion              Boolean                 @default(false)
    isAvailable              Boolean                 @default(false)
    isDiscount               Boolean                 @default(false)
    discountAmount           Int                     @default(0)
    category                 ProductCategory
    title                    String
    titleLong                String
    description              String[]
    deliveryMethod           DeliveryMethod
    reviews                  ProductReview[]
    countryOfOrigin          ProductCountryOfOrigin  @relation(fields: [productCountryOfOriginId], references: [id])
    productCountryOfOriginId String
    characteristics          ProductCharacteristic[]
    type                     ProductType

    @@map("products")
}

model ProductReview {
    id        String   @id @default(cuid())
    author    String
    createdAt DateTime @default(now())
    text      String
    product   Product  @relation(fields: [productId], references: [id])
    productId String

    @@map("product_reviews")
}

model ProductCountryOfOrigin {
    id      String    @id @default(cuid())
    name    String
    nameEN  String
    product Product[]

    @@map("countries_of_origin")
}

model ProductCharacteristic {
    id        String  @id @default(cuid())
    product   Product @relation(fields: [productId], references: [id])
    productId String
    name      String
    value     String
}

enum ProductCategory {
    PAINT_PRODUCTS
    POWER_TOOLS
    WORK_WEAR
    SEASONAL
    FOR_HOME_AND_GARDEN
    HAND_TOOL
}

enum DeliveryMethod {
    PICKUP
    ANY
    COURIER
}

enum ProductType {
    PAINTS
    PRIMERS
    VARNISHES
    PUTTIES
    ENAMELS
    SOLVENTS
    OILS
    PAINT_BRUSHES
    ROLLERS
    MASKING_TAPES
    SPATULAS
    ART_BRUSHES
    PAINT_SPRAYERS
    PAINT_TRAYS
    ABRASIVE_MATERIALS
    PAINT_SPONGES
    PROTECTIVE_FILM
    COVERALLS_AND_GLOVES
    MASKS_AND_RESPIRATORS
    PIGMENTS_AND_DYES
    WOOD_ANTISEPTICS
    DECORATIVE_COATINGS
    DRILLS
    HAMMERS
    SCREWDRIVERS
    PLIERS
    CUTTERS
    WRENCHES
    TOOL_KITS
    TAPE_MEASURES
    LEVELS
    CALIPERS
    SAWS
    CHISELS
    MALLETS
    IMPACT_WRENCHES
    SHARPENERS
    CARPENTRY_TOOLS
    SANDING_BLOCKS
    METAL_SCISSORS
    GLASS_CUTTERS
    VISES
    RIVET_GUNS
    HEX_KEYS
    PIPE_WRENCHES
}
