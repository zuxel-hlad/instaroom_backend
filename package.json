{
  "name": "node_course",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child --compiler-options '{\"module\":\"commonjs\"}' -r tsconfig-paths/register src/server.ts",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "prisma:generate": "prisma generate --schema=./prisma/schema",
    "prisma:migrate": "npm run prisma:migrate:dev --",
    "prisma:migrate:dev": "prisma migrate dev --schema=./prisma/schema",
    "prisma:studio": "prisma studio --schema=./prisma/schema"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "imagekit": "^6.0.0",
    "multer": "^2.0.2",
    "ts-node-dev": "^2.0.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@prisma/client": "^6.13.0",
    "@prisma/extension-accelerate": "^2.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.2.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "prisma": "^6.13.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0"
  }
}
